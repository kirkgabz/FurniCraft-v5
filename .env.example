# Copy to .env.local and fill in. This file is committed; .env.local is not.
# NEVER put a real value in this file -- it goes to GitHub.
# NEXT_PUBLIC_* is shipped to the browser; everything else stays server-side.

# Supabase -- Project Settings > API
# Both are public by design; access is governed by row-level security.
# Never add the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# hCaptcha -- the "I am human" check on sign in, sign up, password reset and
# code resends (components/auth/human-check.tsx). This is the public SITE key
# from https://dashboard.hcaptcha.com; the SECRET key goes in Supabase, not
# here: Authentication > Attack Protection > Enable Captcha protection >
# hCaptcha. Set this and deploy BEFORE enabling captcha in Supabase -- once
# Supabase requires a token, a build without this key cannot sign anyone in.
# Unset: no check is shown and the forms work as before.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Gemini -- app/api/shop-assistant, app/api/architect-analysis and app/api/translate.
# Server-side only. Without it those routes return 503; nothing else breaks.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Vercel provides the site URL automatically; CHROME_PATH is only
# for `npm run architect-analysis`.
# NEXT_PUBLIC_SITE_URL=
# CHROME_PATH=

# Not read from this file: RESEND_API_KEY (order-ready email) and CRON_SECRET
# (account-deletion sweep) belong to supabase/functions/*, which runs on
# Supabase. Set them at Supabase dashboard > Edge Functions > Secrets.
